{
  "imports": {
    "@b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@0.1.56",
    "@grammyjs/auto-retry": "npm:@grammyjs/auto-retry@2.0.2",
    "@grammyjs/parse-mode": "npm:@grammyjs/parse-mode@1.11.1",
    "@grammyjs/runner": "npm:@grammyjs/runner@2.0.3",
    "@grammyjs/types": "npm:@grammyjs/types@5.0.0",
    "@grammyjs/menu": "npm:@grammyjs/menu@1.5.0",
    "@grammyjs/conversations": "npm:@grammyjs/conversations@2.1.1",
    "@std/assert": "jsr:@std/assert@1.0.13",
    "@std/async": "jsr:@std/async@1.0.13",
    "@std/dotenv": "jsr:@std/dotenv@0.225.5",
    "@std/log": "jsr:@std/log@0.224.14",
    "@std/path": "jsr:@std/path@1.1.1",
    "another-cookiejar": "jsr:@jd1378/another-cookiejar@5.0.7",
    "grammy": "npm:grammy@1.46.0",
    "happy-dom": "npm:happy-dom@18.0.1",
    "jsonpath-plus": "npm:jsonpath-plus@10.3.0",
    "zod": "npm:zod@4.0.14"
  },
  "tasks": {
    "format:check": "deno fmt --check",
    "format:fix": "deno fmt",
    "lint:check": "deno lint",
    "ts:check": "deno check --quiet src test --allow-import",
    "issues:check": "deno task format:check ; deno task lint:check ; deno task ts:check",
    "deps:cache": "deno install --allow-import",
    "test:all": "deno test -A",
    "test:tt": "deno test -A test/tiktok",
    "test:ig": "deno test test/instagram -A",
    "test:ig:auth": "deno test test/instagram -A --filter auth",
    "test:ig:anon": "deno test test/instagram -A --filter anon",
    "main": "deno --allow-read --allow-write --allow-net --allow-env --allow-import --allow-run --unstable-detect-cjs ./src/main.ts"
  },
  "exclude": [
    "assets/**"
  ],
  "unstable": [
    "kv"
  ]
}
